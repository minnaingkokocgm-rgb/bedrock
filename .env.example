APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Behind httpd/HTTPS reverse proxy, use your public HTTPS URL (no :8080):
# APP_URL=https://ai-test.q-pass.jp

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Docker Compose — SQLite is used by default (shared via storage volume).
# Compose overrides DB_DATABASE to /var/www/html/storage/app/database.sqlite
# APP_PORT=80
# DB_QUEUE_RETRY_AFTER=720


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be greater than AnalyzeSubmissionJob timeout (660). Docker sets this via compose env if needed.
DB_QUEUE_RETRY_AFTER=720

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# local or s3 — when s3, Bedrock Converse reads files via s3://bucket/key
SUBMISSIONS_DISK=local
# Optional upload ceilings in KB (defaults: document 20480, image 10240, video 1048576 = 1GB)
# SUBMISSIONS_MAX_DOCUMENT_KB=20480
# SUBMISSIONS_MAX_IMAGE_KB=10240
SUBMISSIONS_MAX_VIDEO_KB=1048576

BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# Output token cap for verdict JSON (not the 1M input context).
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.5
# Soft cap on extracted text chars in the prompt (0 = no truncate)
BEDROCK_CONTENT_CHAR_LIMIT=500000
# Seconds to wait for Bedrock Converse (large S3 videos)
BEDROCK_HTTP_TIMEOUT=600
BEDROCK_HTTP_CONNECT_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"
